{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Review Queue",
  "version": "0.1.0",
  "identifier": "com.reviewqueue.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Review Queue",
        "width": 1280,
        "height": 840,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "A local-first desktop review queue",
    "longDescription": "Review local workspace snapshots, GitHub pull requests, and connected-machine rounds from one macOS desktop queue.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQTdBQkZFN0ZCMDc4RTAKUldUZ2VMQi8vcXVuN2N0VWQyT1cvS1VISm1hazhldytrNVdrQXpXTytrTVdKZ1YwNEFJNHBmUzkK",
      "endpoints": [
        "https://github.com/uhvesta/review-queue/releases/latest/download/latest.json"
      ]
    }
  }
}
